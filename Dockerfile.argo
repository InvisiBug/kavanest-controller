## Need a build stage to compile the typescript

## Build stage
FROM  arm64v8/node:20 AS build
WORKDIR /usr/src/app

COPY . .

RUN yarn install
RUN yarn build


## Deploy stage
FROM  arm64v8/node:20

WORKDIR /usr/src/app

COPY --from=build /usr/src/app/dist ./

COPY --from=build /usr/src/app/package*.json ./
COPY --from=build /usr/src/app/tsconfig.json ./

# ENV NODE_ENV production
RUN yarn install

EXPOSE 1883
EXPOSE 9001

CMD ["node","index.js"]
